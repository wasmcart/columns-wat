          (i32.add (i32.const 22) (i32.mul (global.get $cy) (i32.const 15))) (global.get $g0))))
        (if (i32.ge_s (i32.sub (global.get $cy) (i32.const 1)) (i32.const 0)) (then (call $gem
          (i32.add (i32.const 72) (i32.mul (global.get $cx) (i32.const 14)))
          (i32.add (i32.const 22) (i32.mul (i32.sub (global.get $cy) (i32.const 1)) (i32.const 15))) (global.get $g1))))
        (if (i32.ge_s (i32.sub (global.get $cy) (i32.const 2)) (i32.const 0)) (then (call $gem
          (i32.add (i32.const 72) (i32.mul (global.get $cx) (i32.const 14)))
          (i32.add (i32.const 22) (i32.mul (i32.sub (global.get $cy) (i32.const 2)) (i32.const 15))) (global.get $g2))))))
    (call $text (i32.const 3742200) (i32.const 7) (i32.const 170) (i32.const 12) (i32.const 3) (i32.const 0x00f8c850))
    (call $text (i32.const 3742207) (i32.const 5) (i32.const 182) (i32.const 54) (i32.const 2) (i32.const 0x009888b8))
    (call $number (global.get $score) (i32.const 182) (i32.const 68) (i32.const 0x00ffffff))
    (call $text (i32.const 3742212) (i32.const 5) (i32.const 182) (i32.const 96) (i32.const 2) (i32.const 0x009888b8))
    (call $number (global.get $level) (i32.const 182) (i32.const 110) (i32.const 0x00ffffff))
    (call $text (i32.const 3742217) (i32.const 4) (i32.const 182) (i32.const 136) (i32.const 2) (i32.const 0x009888b8))
    (call $gem (i32.const 188) (i32.const 153) (global.get $ng2))
    (call $gem (i32.const 188) (i32.const 167) (global.get $ng1))
    (call $gem (i32.const 188) (i32.const 181) (global.get $ng0))
    (call $text (i32.const 3742300) (i32.const 4) (i32.const 230) (i32.const 202) (i32.const 2) (i32.const 0x009888b8))
    (call $number (i32.load (i32.const 208)) (i32.const 230) (i32.const 216) (i32.const 0x00f8c850))
    (if (i32.gt_u (global.get $chain) (i32.const 1))
      (then (call $text (i32.const 3742221) (i32.const 5) (i32.const 230) (i32.const 154) (i32.const 2) (i32.const 0x00f078f8))
            (call $number (global.get $chain) (i32.const 242) (i32.const 170) (i32.const 0x00ffffff))))
    (if (global.get $paused)
      (then (call $fill (i32.const 76) (i32.const 93) (i32.const 80) (i32.const 32) (i32.const 0x00000000))
            (call $text (i32.const 3742226) (i32.const 6) (i32.const 83) (i32.const 102) (i32.const 3) (i32.const 0x00ffffff))))
    (if (global.get $over)
