          (i32.or (i32.load8_u (i32.add (i32.const 3740000) (i32.add (i32.mul (local.get $y) (i32.const 6)) (local.get $x)))) (i32.const 128)))
        (i32.store8 (i32.add (i32.const 3740000) (i32.add
