  (func $mark (result i32) (local $x i32) (local $y i32) (local $v i32) (local $found i32)
    (local.set $y (i32.const 0))
    (block $yd (loop $yl
      (br_if $yd (i32.ge_u (local.get $y) (i32.const 13)))
      (local.set $x (i32.const 0))
      (block $xd (loop $xl
        (br_if $xd (i32.ge_u (local.get $x) (i32.const 6)))
        (local.set $v (i32.and (i32.load8_u (i32.add (i32.const 3740000)
          (i32.add (i32.mul (local.get $y) (i32.const 6)) (local.get $x)))) (i32.const 7)))
        (if (local.get $v)
          (then
            (local.set $found (i32.or (local.get $found) (call $mark3 (local.get $x) (local.get $y) (i32.const 1) (i32.const 0) (local.get $v))))
            (local.set $found (i32.or (local.get $found) (call $mark3 (local.get $x) (local.get $y) (i32.const 0) (i32.const 1) (local.get $v))))
            (local.set $found (i32.or (local.get $found) (call $mark3 (local.get $x) (local.get $y) (i32.const 1) (i32.const 1) (local.get $v))))
            (local.set $found (i32.or (local.get $found) (call $mark3 (local.get $x) (local.get $y) (i32.const -1) (i32.const 1) (local.get $v))))))
        (local.set $x (i32.add (local.get $x) (i32.const 1))) (br $xl)))
      (local.set $y (i32.add (local.get $y) (i32.const 1))) (br $yl)))
    (local.get $found))

  (func $collapse (result i32) (local $x i32) (local $y i32) (local $write i32) (local $v i32) (local $n i32)
    (local.set $x (i32.const 0))
    (block $xd (loop $xl
      (br_if $xd (i32.ge_u (local.get $x) (i32.const 6)))
      (local.set $write (i32.const 12)) (local.set $y (i32.const 12))
      (block $yd (loop $yl
        (br_if $yd (i32.lt_s (local.get $y) (i32.const 0)))
        (local.set $v (i32.load8_u (i32.add (i32.const 3740000)
          (i32.add (i32.mul (local.get $y) (i32.const 6)) (local.get $x)))))
        (if (i32.and (local.get $v) (i32.eqz (i32.and (local.get $v) (i32.const 128))))
          (then
            (i32.store8 (i32.add (i32.const 3740000)
              (i32.add (i32.mul (local.get $write) (i32.const 6)) (local.get $x))) (local.get $v))
            (local.set $write (i32.sub (local.get $write) (i32.const 1))))
          (else (if (i32.and (local.get $v) (i32.const 128)) (then (local.set $n (i32.add (local.get $n) (i32.const 1)))))))
        (local.set $y (i32.sub (local.get $y) (i32.const 1))) (br $yl)))
      (block $cd (loop $cl
        (br_if $cd (i32.lt_s (local.get $write) (i32.const 0)))
        (i32.store8 (i32.add (i32.const 3740000)
          (i32.add (i32.mul (local.get $write) (i32.const 6)) (local.get $x))) (i32.const 0))
        (local.set $write (i32.sub (local.get $write) (i32.const 1))) (br $cl)))
      (local.set $x (i32.add (local.get $x) (i32.const 1))) (br $xl)))
    (local.get $n))

  (func $resolve (local $n i32)
    (global.set $chain (i32.const 0))
    (block $done (loop $again
      (br_if $done (i32.eqz (call $mark)))
      (global.set $chain (i32.add (global.get $chain) (i32.const 1)))
      (local.set $n (call $collapse))
      (global.set $lines (i32.add (global.get $lines) (local.get $n)))
      (global.set $score (i32.add (global.get $score)
        (i32.mul (local.get $n) (i32.mul (i32.const 10) (global.get $chain)))))
      (global.set $level (i32.div_u (global.get $lines) (i32.const 30)))
      (call $tone (i32.add (i32.const 600) (i32.mul (global.get $chain) (i32.const 140))) (i32.const 1600))
      (br $again))))

  (func $c_lock (local $y i32)
    (if (i32.lt_s (i32.sub (global.get $cy) (i32.const 2)) (i32.const 0))
      (then (global.set $over (i32.const 1)) (call $tone (i32.const 105) (i32.const 8000))
        (if (i32.gt_u (global.get $score) (i32.load (i32.const 208)))
          (then (i32.store (i32.const 208) (global.get $score))))
        (return)))
    (local.set $y (global.get $cy))
    (i32.store8 (i32.add (i32.const 3740000) (i32.add (i32.mul (local.get $y) (i32.const 6)) (global.get $cx))) (global.get $g0))
    (i32.store8 (i32.add (i32.const 3739994) (i32.add (i32.mul (local.get $y) (i32.const 6)) (global.get $cx))) (global.get $g1))
    (i32.store8 (i32.add (i32.const 3739988) (i32.add (i32.mul (local.get $y) (i32.const 6)) (global.get $cx))) (global.get $g2))
    (call $resolve) (call $c_spawn))

  (func $c_can_down (result i32)
    (if (i32.ge_s (global.get $cy) (i32.const 12)) (then (return (i32.const 0))))
    (i32.eqz (i32.load8_u (i32.add (i32.const 3740006)
      (i32.add (i32.mul (global.get $cy) (i32.const 6)) (global.get $cx))))))

  (func $c_draw (local $x i32) (local $y i32) (local $v i32)
    (call $fill (i32.const 0) (i32.const 0) (i32.const 320) (i32.const 240) (i32.const 0x00100820))
    ;; Stone-like frame and black well, based on the original arcade layout.
    (call $fill (i32.const 62) (i32.const 12) (i32.const 104) (i32.const 218) (i32.const 0x00704028))
    (call $fill (i32.const 68) (i32.const 18) (i32.const 92) (i32.const 206) (i32.const 0x00100818))
    (local.set $y (i32.const 0))
    (block $yd (loop $yl
      (br_if $yd (i32.ge_u (local.get $y) (i32.const 13)))
      (local.set $x (i32.const 0))
      (block $xd (loop $xl
        (br_if $xd (i32.ge_u (local.get $x) (i32.const 6)))
        (local.set $v (i32.and (i32.load8_u (i32.add (i32.const 3740000)
          (i32.add (i32.mul (local.get $y) (i32.const 6)) (local.get $x)))) (i32.const 7)))
        (if (local.get $v)
          (then (call $gem (i32.add (i32.const 72) (i32.mul (local.get $x) (i32.const 14)))
            (i32.add (i32.const 22) (i32.mul (local.get $y) (i32.const 15))) (local.get $v)))
          (else (call $fill (i32.add (i32.const 72) (i32.mul (local.get $x) (i32.const 14)))
            (i32.add (i32.const 22) (i32.mul (local.get $y) (i32.const 15)))
            (i32.const 13) (i32.const 13) (i32.const 0x00181428))))
        (local.set $x (i32.add (local.get $x) (i32.const 1))) (br $xl)))
      (local.set $y (i32.add (local.get $y) (i32.const 1))) (br $yl)))
    (if (i32.eqz (global.get $over))
      (then
        (if (i32.ge_s (global.get $cy) (i32.const 0)) (then (call $gem
